@page "/organizacion/potrero/{PotreroId}"
@inject AuthenticationService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject PotreroService PotreroService
@inject RanchoService RanchoService
@inject EmpresaService EmpresaService

<PageTitle>Detalle Potrero</PageTitle>

@if (!IsAuthenticated)
{
    <p>Redirigiendo al login...</p>
}
else if (Potrero == null)
{
    <div class="alert alert-warning">Potrero no encontrado.</div>
}
else
{
    <div class="container-fluid">
        <!-- Header con información del recurso -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <button class="btn btn-link text-muted p-0 mb-2" @onclick="GoBack">← Volver</button>
                        <h2 class="mb-1">@Potrero.NombrePotrero</h2>
                        <p class="text-muted mb-0">
                            @if (Rancho != null)
                            {
                                <span>@Rancho.NombreRancho / </span>
                            }
                            <span>Potrero</span>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Barra de acciones principal -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-primary" @onclick="EditarPotrero">Editar</button>
                    <button class="btn btn-outline-danger" @onclick="EliminarPotrero">Eliminar</button>
                    <button class="btn btn-outline-secondary" @onclick="CopiarId">Copiar ID</button>
                    <div class="ms-auto">
                        <button class="btn btn-outline-secondary" @onclick="RefreshData">Actualizar</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabs de navegación -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="border-bottom">
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" 
                                    id="resumen-tab" 
                                    @onclick="@(async e => SelectTab("resumen"))"
                                    type="button" role="tab">
                                Resumen
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Contenido de las tabs -->
        <div class="row">
            <div class="col-12">
                <!-- Tab: Resumen -->
                <div class="tab-pane active" id="resumen" role="tabpanel">
                    <div class="row g-4">
                        <!-- Panel Información General -->
                        <div class="col-12 col-lg-6">
                            <div class="card shadow-sm">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0 fw-bold">Información General</h6>
                                </div>
                                <div class="card-body">
                                    <div class="row mb-3">
                                        <div class="col-12">
                                            <label class="form-label text-muted small">Nombre</label>
                                            <p class="fw-bold">@Potrero.NombrePotrero</p>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-12">
                                            <label class="form-label text-muted small">Área</label>
                                            <p>@Potrero.Area</p>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-6">
                                            <label class="form-label text-muted small">Latitud</label>
                                            <p>@Potrero.Latitude</p>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label text-muted small">Longitud</label>
                                            <p>@Potrero.Longitude</p>
                                        </div>
                                    </div>
                                    <div class="row mb-0">
                                        <div class="col-12">
                                            <label class="form-label text-muted small">Rancho</label>
                                            <p>@(Rancho?.NombreRancho ?? "-")</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Panel Identificadores -->
                        <div class="col-12 col-lg-6">
                            <div class="card shadow-sm">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0 fw-bold">Identificadores</h6>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label class="form-label text-muted small">ID Potrero</label>
                                        <div class="input-group input-group-sm">
                                            <input type="text" class="form-control" value="@Potrero.IdPotrero" readonly />
                                            <button class="btn btn-outline-secondary" type="button" @onclick="@(async e => await CopiarAlPortapapeles(Potrero.IdPotrero))">
                                                Copiar
                                            </button>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label text-muted small">UUID Sistema</label>
                                        <div class="input-group input-group-sm">
                                            <input type="text" class="form-control" value="@Potrero.UuidSistema" readonly />
                                            <button class="btn btn-outline-secondary" type="button" @onclick="@(async e => await CopiarAlPortapapeles(Potrero.UuidSistema))">
                                                Copiar
                                            </button>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label text-muted small">ID Rancho</label>
                                        <p class="small">@Potrero.IdRancho</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string PotreroId { get; set; } = string.Empty;

    private bool IsAuthenticated;
    private Potrero? Potrero;
    private Rancho? Rancho;
    private EmpresaGanadera? Empresa;
    private string ActiveTab = "resumen";

    protected override async Task OnInitializedAsync()
    {
        IsAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (!IsAuthenticated)
        {
            Navigation.NavigateTo("/");
            return;
        }

        await LoadPotreroData();
    }

    private async Task LoadPotreroData()
    {
        Potrero = await PotreroService.GetPotreroByIdAsync(PotreroId);
        if (Potrero != null)
        {
            Rancho = await RanchoService.GetRanchoByIdAsync(Potrero.IdRancho);
            if (Rancho != null)
            {
                Empresa = await EmpresaService.GetEmpresaByIdAsync(Rancho.IdEmpresa);
            }
        }
    }

    private void SelectTab(string tabName) => ActiveTab = tabName;
    private void GoBack() => Navigation.NavigateTo("/organizacion");

    private void EditarPotrero()
    {
        // Implementar funcionalidad de editar
    }

    private async Task EliminarPotrero()
    {
        if (Potrero != null && await JSRuntime.InvokeAsync<bool>("confirm", $"¿Estás seguro de que deseas eliminar el potrero {Potrero.NombrePotrero}?"))
        {
            // Implementar funcionalidad de eliminar
        }
    }

    private async Task CopiarId()
    {
        if (Potrero != null)
        {
            await CopiarAlPortapapeles(Potrero.IdPotrero);
        }
    }

    private async Task CopiarAlPortapapeles(string texto)
    {
        // Implementar copia al portapapeles
        await Task.CompletedTask;
    }

    private async Task RefreshData()
    {
        await LoadPotreroData();
        StateHasChanged();
    }
}
