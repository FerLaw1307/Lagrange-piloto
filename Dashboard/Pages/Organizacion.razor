    private void NavigateToEmpresa(string id) => Navigation.NavigateTo($"organizacion/empresa/{id}");
    private void NavigateToRancho(string id) => Navigation.NavigateTo($"organizacion/rancho/{id}");
    private void NavigateToPotrero(string id) => Navigation.NavigateTo($"organizacion/potrero/{id}");
    private void NavigateToCorral(string id) => Navigation.NavigateTo($"organizacion/corral/{id}");

    private static string CreateId(string prefix)
    {
        return $"{prefix}-{Guid.NewGuid().ToString("N").Substring(0, 8).ToUpper()}";
    }
